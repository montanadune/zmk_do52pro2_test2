#include <physical_layouts.dtsi>

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
            RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,6) RC(4,7)                 RC(4,10) RC(4,11)

            // DPAD (Right)
            RC(5,7) RC(5,8) RC(5,10) RC(5,9) RC(5,6)
        >;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Do52 Right Only";
        kscan = <&kscan0>;
        transform = <&default_transform>;
        keys =//                     w   h    x    y     rot    rx    ry
              // Number row
              <&key_physical_attrs 100 100  150   50       0     0     0>
            , <&key_physical_attrs 100 100  250   25       0     0     0>
            , <&key_physical_attrs 100 100  350    0       0     0     0>
            , <&key_physical_attrs 100 100  450   25       0     0     0>
            , <&key_physical_attrs 100 100  550   50       0     0     0>
            , <&key_physical_attrs 100 100  650   75       0     0     0>
            // Top letter row
            , <&key_physical_attrs 100 100  150  150       0     0     0>
            , <&key_physical_attrs 100 100  250  125       0     0     0>
            , <&key_physical_attrs 100 100  350  100       0     0     0>
            , <&key_physical_attrs 100 100  450  125       0     0     0>
            , <&key_physical_attrs 100 100  550  150       0     0     0>
            , <&key_physical_attrs 100 100  650  175       0     0     0>
            // Middle letter row
            , <&key_physical_attrs 100 100  150  250       0     0     0>
            , <&key_physical_attrs 100 100  250  225       0     0     0>
            , <&key_physical_attrs 100 100  350  200       0     0     0>
            , <&key_physical_attrs 100 100  450  225       0     0     0>
            , <&key_physical_attrs 100 100  550  250       0     0     0>
            , <&key_physical_attrs 100 100  650  275       0     0     0>
            // Bottom letter row
            , <&key_physical_attrs 100 100  150  350       0     0     0>
            , <&key_physical_attrs 100 100  250  325       0     0     0>
            , <&key_physical_attrs 100 100  350  300       0     0     0>
            , <&key_physical_attrs 100 100  450  325       0     0     0>
            , <&key_physical_attrs 100 100  550  350       0     0     0>
            , <&key_physical_attrs 100 100  650  375       0     0     0>
            // Thumb row
            , <&key_physical_attrs 100 100  150  475       0     0     0>
            , <&key_physical_attrs 100 100  250  450       0     0     0>
            , <&key_physical_attrs 100 100  550  475       0     0     0>
            , <&key_physical_attrs 100 100  650  500       0     0     0>
            // DPAD
            , <&key_physical_attrs  50  50    0  500       0     0     0>
            , <&key_physical_attrs  50  50   50  550       0     0     0>
            , <&key_physical_attrs  50  50   50  500       0     0     0>
            , <&key_physical_attrs  50  50   50  450       0     0     0>
            , <&key_physical_attrs  50  50  100  500       0     0     0>
            ;
    };
};
